const cursor=document.querySelector('.cursor'),reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;let mx=-100,my=-100,cx=-100,cy=-100;document.addEventListener('pointermove',e=>{mx=e.clientX;my=e.clientY;cursor.classList.toggle('active',!!e.target.closest('a,button'))});function follow(){cx+=(mx-cx)*.16;cy+=(my-cy)*.16;cursor.style.transform=`translate(${cx-15}px,${cy-15}px) rotate(${cx/9}deg)`;requestAnimationFrame(follow)}if(!reduced&&matchMedia('(pointer:fine)').matches)follow();document.addEventListener('click',e=>{if(reduced)return;for(let i=0;i<7;i++){const s=document.createElement('span');s.className='spark';s.textContent=['✳','·','+'][i%3];s.style.cssText=`left:${e.clientX}px;top:${e.clientY}px;--sx:${(Math.random()-.5)*150}px;--sy:${-Math.random()*120}px`;document.body.append(s);setTimeout(()=>s.remove(),850)}});const selected=new Set(),buttons=[...document.querySelectorAll('[data-item]')],count=document.querySelector('#count'),message=document.querySelector('#pack-message');function update(){count.textContent=`${selected.size} / 3`;buttons.forEach(b=>b.setAttribute('aria-pressed',String(selected.has(b.dataset.item))));message.textContent=selected.size===3?'Çanta hazır! Şimdi sıra ekibini toplamakta.':selected.size?`${[...selected].join(' + ')}. ${3-selected.size} eşya daha seçebilirsin.`:'İlk eşyanı seç. Macera bekliyor.'}buttons.forEach(b=>b.addEventListener('click',()=>{const item=b.dataset.item;if(selected.has(item))selected.delete(item);else if(selected.size<3)selected.add(item);else{message.textContent='Çantan dolu! Değiştirmek için önce bir eşyayı çıkar.';return}update()}));document.querySelector('#reset').addEventListener('click',()=>{selected.clear();update()});const progress=document.querySelector('.progress');function scrollUpdate(){const max=document.documentElement.scrollHeight-innerHeight;progress.style.width=`${max?scrollY/max*100:0}%`}addEventListener('scroll',scrollUpdate,{passive:true});addEventListener('resize',scrollUpdate);scrollUpdate();
