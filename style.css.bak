@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;600;700;800&display=swap');
:root{--paper:#f2f0df;--ink:#293c2d;--orange:#e86540;--purple:#bbb0dc}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}a,button{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:6px}.progress{position:fixed;top:0;left:0;height:4px;background:var(--orange);z-index:30;width:0}header{height:100px;display:flex;align-items:center;justify-content:space-between;margin:0 5%;border-bottom:1px solid #293c2d33}.brand{font-family:Manrope,sans-serif;font-size:32px;font-weight:800;letter-spacing:-2px}.brand span{font-size:20px;margin-left:7px}nav{display:flex;align-items:center;gap:36px;font-size:13px;font-weight:600}.nav-cta{border:1px solid var(--ink);border-radius:30px;padding:13px 21px}.nav-cta:hover{background:var(--ink);color:var(--paper)}.hero{padding:40px 5% 0;position:relative;overflow:hidden}.eyebrow,.section-label,small,.scene-caption{font-size:10px;letter-spacing:1.5px;font-weight:700}.eyebrow{display:flex;align-items:center;gap:9px}.dot{height:7px;width:7px;background:var(--orange);border-radius:50%}h1{font:800 clamp(90px,12.5vw,190px)/.89 Manrope,sans-serif;letter-spacing:-.075em;margin:37px 0 22px;position:relative;z-index:2;max-width:900px}em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.065em}h1 em{color:var(--orange)}.asterisk{font-size:.52em;display:inline-block;vertical-align:top;margin:14px 0 0 30px;color:var(--orange);animation:spin 22s linear infinite}.hero-bottom{display:flex;align-items:center;gap:70px;position:relative;z-index:2}.hero-bottom p{font-size:15px;line-height:1.65}.round-link{display:grid;place-items:center;border:1px solid var(--ink);border-radius:50%;width:58px;height:58px;font-size:28px;transition:.25s}.round-link:hover{background:var(--orange);transform:translateY(6px)}.side-note{font:italic 24px Georgia;transform:rotate(-10deg);margin-left:auto;margin-right:15%;position:relative}.side-note svg{position:absolute;width:70px;top:35px;left:70px;fill:none;stroke:var(--ink);stroke-width:2}.sticker{position:absolute;right:9%;top:95px;width:125px;height:125px;border-radius:50%;background:var(--purple);display:flex;align-items:center;justify-content:center;flex-direction:column;font-weight:800;font-size:18px;line-height:1.1;transform:rotate(13deg);z-index:3;border:1px solid var(--ink)}.sticker span{position:absolute;right:19px;top:47px;font-size:30px}.sticker small{font-size:8px;margin-top:10px}.landscape{margin:-30px -5.6% 0;position:relative;height:auto}.landscape svg{display:block;width:100%;min-height:240px}.scene-caption{position:absolute;bottom:17px;left:5%;font-size:8px}.clouds{animation:cloud 15s ease-in-out infinite alternate}.scout{transform-box:fill-box;transform-origin:center;animation:wobble 4s ease-in-out infinite alternate}.ticker{background:var(--ink);color:var(--paper);overflow:hidden;padding:20px 0;font-size:15px;letter-spacing:3px;white-space:nowrap}.ticker span{display:inline-block;animation:marquee 36s linear infinite}.section{padding:100px 8%}.section-label{margin-bottom:35px}h2{font:800 clamp(45px,5.8vw,84px)/1.05 Manrope,sans-serif;letter-spacing:-.06em;margin:0 0 35px}.story-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:70px}p{line-height:1.7}.big-copy{font-size:24px;line-height:1.45;margin-top:0}.story-grid p:not(.big-copy){font-size:15px;opacity:.8}.text-link{font-size:13px;display:inline-block;border-bottom:1px solid;padding-bottom:7px;margin-top:15px}.photo-note{margin:70px auto 0;max-width:900px;background:#fffdf2;padding:16px 16px 30px;transform:rotate(-2deg);box-shadow:0 6px 20px #293c2d12}.photo-note img{width:100%;max-height:430px;object-fit:cover;display:block;background:#78895d}.photo-note>span{display:block;font:italic 24px Georgia;margin:20px 10px 0}.photo-note small{display:block;font:11px 'DM Sans';margin-top:10px;letter-spacing:0}.rules{background:#e5e7d5}.rule-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:45px;margin-top:60px}.rule-grid article{border-top:1px solid #293c2d55;padding-top:25px}.rule-icon{display:block;font:70px Georgia;color:var(--orange);height:95px}.rule-grid small{font-size:9px}h3{font:700 28px Manrope;letter-spacing:-1px;margin:20px 0 10px}.rule-grid p{font-size:14px;max-width:300px}.pack{display:grid;grid-template-columns:1fr 1fr;gap:60px;position:relative}.pack h2 em{color:var(--orange)}.pack p{font-size:15px}.pack-status{margin-top:40px;border-top:1px solid #293c2d55;padding-top:20px;font-size:11px;letter-spacing:1px}.pack-status b{float:right}.pack-status p{letter-spacing:0;font-size:13px;min-height:24px}.reset{background:none;border:0;border-bottom:1px solid;padding:4px 0;font-size:12px;cursor:pointer}.items{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.items button{border:1px solid #293c2d44;border-radius:8px;background:#ebe7d8;display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:160px;cursor:pointer;transition:transform .2s,background .2s;position:relative;font-weight:600}.items button:hover{transform:rotate(-3deg) translateY(-5px);background:#e2dabd}.items button[aria-pressed=true]{background:var(--purple);border-color:var(--ink)}.items button[aria-pressed=true]:after{content:'✓';position:absolute;right:12px;top:8px}.items button span{font-size:50px;display:block;margin-bottom:12px}.items button small{font-weight:400;letter-spacing:0;font-size:10px;margin-top:5px}.demo-note{grid-column:1/-1;font-size:9px;letter-spacing:0;text-align:right;opacity:.65}.finale{background:var(--orange);text-align:center;padding-bottom:70px;position:relative}.finale h2{font-size:clamp(66px,9vw,130px);line-height:.98}.finale h2 em{color:var(--paper)}.big-cta{display:inline-flex;align-items:center;gap:40px;padding:20px 30px;border:1px solid var(--ink);border-radius:50px;background:var(--paper);font-size:16px;transition:.2s}.big-cta:hover{background:var(--ink);color:var(--paper);transform:rotate(-2deg)}.big-cta span{font-size:26px}.finale p{font-size:12px;margin:25px 0 55px}.back-top{font-size:11px;border-bottom:1px solid;padding-bottom:5px}footer{display:flex;align-items:center;justify-content:space-between;padding:40px 5%;gap:25px}footer p,footer>a:last-child{font-size:10px;line-height:1.6}.cursor{position:fixed;left:-100px;top:-100px;z-index:100;pointer-events:none;color:var(--orange);font-size:30px;transition:font-size .15s;mix-blend-mode:multiply}.cursor.active{font-size:50px}.spark{position:fixed;pointer-events:none;z-index:99;color:var(--orange);animation:pop .8s forwards;font-size:20px}@keyframes pop{to{transform:translate(var(--sx),var(--sy)) rotate(100deg);opacity:0}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes marquee{to{transform:translateX(-40%)}}@keyframes cloud{to{transform:translateX(35px)}}@keyframes wobble{to{rotate:5deg}}@media(min-width:900px){body{cursor:none}a,button{cursor:none!important}}@media(max-width:800px){header{height:80px}nav{gap:16px}nav>a:not(.nav-cta){display:none}.hero{padding-top:30px}h1{font-size:17vw;margin-top:40px}.asterisk{margin-left:14px}.sticker{top:56px;right:7%;width:80px;height:80px;font-size:12px}.sticker span{right:8px;top:28px;font-size:20px}.sticker small{font-size:6px}.eyebrow{font-size:8px;letter-spacing:1px}.hero-bottom{gap:25px}.hero-bottom p{font-size:12px}.side-note{font-size:18px;margin-right:7%}.side-note svg{width:45px;left:30px}.landscape{margin-top:10px}.scene-caption{font-size:6px}.section{padding:65px 6%}.story-grid,.pack{grid-template-columns:1fr;gap:20px}.big-copy{font-size:21px}.rule-grid{grid-template-columns:1fr;gap:20px;margin-top:20px}.rule-grid article{display:grid;grid-template-columns:70px 1fr;column-gap:15px}.rule-icon{grid-row:1/4;font-size:50px}.rule-grid h3{margin:10px 0}.rule-grid p{max-width:none;margin:0 0 10px}.photo-note{margin-top:40px}.photo-note>span{font-size:19px}.items{margin-top:20px}.items button{min-height:145px}.pack-status{margin-top:25px}footer{flex-wrap:wrap}footer p{max-width:230px}.cursor{display:none}.ticker{font-size:11px;padding:16px 0}.scene-caption{display:none}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}.cursor{display:none}body,a,button{cursor:auto!important}}
